{
  "name": "kodspot-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Kodspot Flow — Edge-native invoice automation for Kodspot",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "deploy": "turbo run deploy",
    "db:generate": "pnpm --filter @kodspot/api db:generate",
    "db:migrate:local": "pnpm --filter @kodspot/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @kodspot/api db:migrate:remote",
    "db:seed": "pnpm --filter @kodspot/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  }
}
