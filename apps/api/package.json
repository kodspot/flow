{
  "name": "@kodspot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy",
    "cf:deploy": "wrangler d1 migrations apply kodspot-flow-db --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kodspot-flow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kodspot-flow-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@kodspot/shared": "workspace:*",
    "@cloudflare/puppeteer": "^0.0.14",
    "hono": "^4.6.10",
    "drizzle-orm": "^0.36.3",
    "zod": "^3.23.8",
    "nanoid": "^5.0.8",
    "@tsndr/cloudflare-worker-jwt": "^3.1.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0",
    "tsx": "^4.19.2"
  }
}
